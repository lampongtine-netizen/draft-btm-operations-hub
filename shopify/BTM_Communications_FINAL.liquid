{% liquid
assign portal_preview = false
if request.design_mode
assign portal_preview = true
endif
assign level_one_member = false
assign level_two_member = false
assign btm_has_certificate = false
if customer
if customer.tags contains 'BTM Level 1'
assign level_one_member = true
endif
if customer.tags contains 'BTM Business Advisory'
assign level_one_member = true
endif
if customer.tags contains 'Business Advisory & Support'
assign level_one_member = true
endif
if customer.tags contains 'BTM Graduate Support'
assign level_one_member = true
endif
if customer.tags contains 'BTM Level 2'
assign level_two_member = true
endif
if customer.tags contains 'BTM Scale Society'
assign level_two_member = true
endif
if customer.tags contains 'Scale Society'
assign level_two_member = true
endif
if customer.tags contains 'BTM Mentorship Graduate'
assign btm_has_certificate = true
endif
if customer.tags contains 'BTM Graduate Support'
assign btm_has_certificate = true
endif
endif
assign portal_allowed = false
if portal_preview
assign portal_allowed = true
endif
if level_one_member
assign portal_allowed = true
endif
if level_two_member
assign portal_allowed = true
endif
assign btm_level_two = level_two_member
assign member_name = 'BTM Member'
assign member_initials = 'BM'
assign member_business = blank
assign support_space_name = 'private-support'
if customer
assign member_name = customer.first_name | append: ' ' | append: customer.last_name | strip
if customer.first_name != blank
assign first_initial = customer.first_name | slice: 0
assign support_space_name = 'btm-' | append: customer.first_name | downcase | replace: ' ', '-'
else
assign first_initial = 'B'
endif
if customer.last_name != blank
assign last_initial = customer.last_name | slice: 0
else
assign last_initial = 'M'
endif
assign member_initials = first_initial | append: last_initial | upcase
if customer.metafields.btm.business_name.value != blank
assign member_business = customer.metafields.btm.business_name.value
endif
endif
if portal_preview
assign portal_allowed = true
assign member_name = 'Donamae Morales'
assign member_initials = 'DM'
assign member_business = 'Member'
assign support_space_name = 'btm-donamae'
endif
%}
<section
id="btm-comms-v2-{{ section.id }}"
class="btmcommsv2"
data-member-id="{% if customer %}{{ customer.id }}{% else %}preview{% endif %}"
data-member-name="{{ member_name | escape }}"
data-member-initials="{{ member_initials | escape }}"
data-support-space="{{ support_space_name | escape }}"
>
{% if portal_allowed %}
<aside class="btmcommsv2__portal-side" aria-label="BTM Members Portal navigation">
<button type="button" class="btmcommsv2__side-toggle" data-side-toggle aria-label="Minimise portal navigation" aria-expanded="true">
<svg viewBox="0 0 24 24"><path d="M15 6l-6 6 6 6"></path></svg>
</button>
<div class="btmcommsv2__side-inner">
<a href="/pages/btm-graduate-portal" class="btmcommsv2__side-brand">
<strong>BTM</strong>
<span>MEMBERS PORTAL</span>
</a>
<nav class="btmcommsv2__side-nav">
<a href="/pages/btm-graduate-portal" class="btmcommsv2__side-link">
<span class="btmcommsv2__side-icon"><svg viewBox="0 0 24 24"><rect x="4" y="4" width="6" height="6"></rect><rect x="14" y="4" width="6" height="6"></rect><rect x="4" y="14" width="6" height="6"></rect><rect x="14" y="14" width="6" height="6"></rect></svg></span>
<span class="btmcommsv2__side-label">Dashboard</span>
</a>
<a href="/pages/btm-how-to-use" class="btmcommsv2__side-link">
<span class="btmcommsv2__side-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"></circle><path d="M9.7 9a2.5 2.5 0 1 1 3.3 2.4c-.7.3-1 .8-1 1.6"></path><path d="M12 17h.01"></path></svg></span>
<span class="btmcommsv2__side-label">How to Use</span>
</a>
<a href="/pages/btm-support-plan" class="btmcommsv2__side-link">
<span class="btmcommsv2__side-icon"><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6z"></path><path d="M15 3v5h4"></path><path d="M9 12h6M9 16h6"></path></svg></span>
<span class="btmcommsv2__side-label">My Support Plan</span>
</a>
<a href="/pages/btm-monthly-check-in" class="btmcommsv2__side-link">
<span class="btmcommsv2__side-icon"><svg viewBox="0 0 24 24"><path d="M5 8l3 3 4-6 4 6 3-3-2 12H7z"></path></svg></span>
<span class="btmcommsv2__side-label">Monthly Check-In</span>
</a>
<a href="/pages/btm-power-sessions" class="btmcommsv2__side-link">
<span class="btmcommsv2__side-icon"><svg viewBox="0 0 24 24"><rect x="3" y="6" width="14" height="12" rx="2"></rect><path d="M17 10l4-2v8l-4-2"></path></svg></span>
<span class="btmcommsv2__side-label">Power Sessions</span>
</a>
<a href="/pages/btm-communications" class="btmcommsv2__side-link is-active">
<span class="btmcommsv2__side-icon"><svg viewBox="0 0 24 24"><path d="M4 5h16v11H9l-5 4z"></path><path d="M8 9h8M8 12h6"></path></svg></span>
<span class="btmcommsv2__side-label">Communications</span>
</a>
<a href="/pages/btm-resources" class="btmcommsv2__side-link">
<span class="btmcommsv2__side-icon"><svg viewBox="0 0 24 24"><path d="M3 6h7l2 2h9v11H3z"></path></svg></span>
<span class="btmcommsv2__side-label">Resources</span>
</a>
<a href="/pages/btm-scale-society" class="btmcommsv2__side-link">
<span class="btmcommsv2__side-icon"><svg viewBox="0 0 24 24"><path d="M4 20V11M10 20V5M16 20v-8"></path><path d="M3 20h18"></path><path d="M15 5l2-2 4 4"></path></svg></span>
<span class="btmcommsv2__side-label">Scale Society</span>
<span class="btmcommsv2__side-badge">{% if btm_level_two %}LEVEL 2{% else %}LOCKED{% endif %}</span>
</a>
<a href="/pages/btm-educational-pathway" class="btmcommsv2__side-link">
<span class="btmcommsv2__side-icon"><svg viewBox="0 0 24 24"><path d="M5 4h6a3 3 0 0 1 3 3v13a3 3 0 0 0-3-3H5z"></path><path d="M19 4h-5v16a3 3 0 0 1 3-3h2z"></path></svg></span>
<span class="btmcommsv2__side-label">Education Pathway</span>
</a>
<a href="/pages/work-with-bree-1-1-mentorship-program" class="btmcommsv2__side-link">
<span class="btmcommsv2__side-icon btmcommsv2__side-icon-text">1:1</span>
<span class="btmcommsv2__side-label">1:1 Mentorship</span>
</a>
<a href="/pages/btm-unwritten-podcast" class="btmcommsv2__side-link">
<span class="btmcommsv2__side-icon"><svg viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3"></rect><path d="M6 11a6 6 0 0 0 12 0M12 17v4M9 21h6"></path></svg></span>
<span class="btmcommsv2__side-label">Unwritten Podcast</span>
</a>
{% if btm_has_certificate %}
<a href="/pages/btm-certificate" class="btmcommsv2__side-link">
<span class="btmcommsv2__side-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="9" r="4"></circle><path d="M9 13l-1 8 4-2 4 2-1-8"></path></svg></span>
<span class="btmcommsv2__side-label">Certificate</span>
</a>
{% endif %}
<a href="/pages/btm-my-details" class="btmcommsv2__side-link">
<span class="btmcommsv2__side-icon"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"></circle><path d="M5 21a7 7 0 0 1 14 0"></path></svg></span>
<span class="btmcommsv2__side-label">My Details</span>
</a>
</nav>
<div class="btmcommsv2__side-bottom">
<a href="{{ routes.account_logout_url }}" class="btmcommsv2__side-link">
<span class="btmcommsv2__side-icon"><svg viewBox="0 0 24 24"><path d="M10 5H5v14h5M13 8l4 4-4 4M8 12h9"></path></svg></span>
<span class="btmcommsv2__side-label">Sign Out</span>
</a>
</div>
</div>
</aside>
<button type="button" class="btmcommsv2__mobile-menu" data-mobile-menu aria-label="Open portal menu">
<span></span><span></span><span></span>
</button>
<button type="button" class="btmcommsv2__overlay" data-overlay aria-label="Close menu"></button>
<div class="btmcommsv2__main">
<header class="btmcommsv2__topbar">
<div class="btmcommsv2__top-left"><span>BTM BUSINESS ADVISORY &amp; SUPPORT</span><strong>Communications</strong></div>
<div class="btmcommsv2__top-status"><i></i><div><strong>BTM Support</strong><small>Usually within a few hours · always within 1 business day</small></div></div>
</header>
<main class="btmcommsv2__workspace">
<section class="btmcommsv2__chat">
<div class="btmcommsv2__intro compact">
<div><span class="btmcommsv2__eyebrow">YOUR PRIVATE SPACE</span><h1>Ask. Share. Keep moving.</h1></div>
</div>
<div class="btmcommsv2__welcome">
<img src="https://cdn.shopify.com/s/files/1/0737/4523/6275/files/IMG_6145_1.jpg?v=1787222707" alt="Bree Wilkinson">
<div><span>A NOTE FROM BREE</span><h2>Hey there! 👋 Welcome to your private support space.</h2><p>Send me anything you need help with in your business — questions, wins, quick decisions, offer feedback, marketing, sales, team, systems, strategy updates, screenshots, files, links, or just what feels stuck. No question is too big or too small. We’re here to support you.</p><strong>Bree xx</strong></div>
</div>
<div class="btmcommsv2__control-row">
<div class="btmcommsv2__quick"><span>QUICK ACTIONS</span><div>
<button type="button" data-prompt="I have a question about…">💬 Question</button>
<button type="button" data-prompt="Quick business update: ">▤ Update</button>
<button type="button" data-prompt="Could you please review this and let me know what you would change? ">⌕ Need Review</button>
<button type="button" data-prompt="I need support deciding what to do about…">♧ Strategy Support</button>
<button type="button" data-prompt="I need help with my marketing, content or promotion for…">◎ Marketing Help</button>
<button type="button" data-prompt="Win to share ✨ ">☆ Win</button>
</div></div>
<div class="btmcommsv2__tools"><label>⌕ <input type="search" data-search placeholder="Search this conversation…"></label><button type="button" data-latest>Latest ↓</button></div>
</div>
<div class="btmcommsv2__messages" data-message-list>
<div class="btmcommsv2__divider"><span>TODAY</span></div>
<article class="btmcommsv2__message static">
<img src="https://cdn.shopify.com/s/files/1/0737/4523/6275/files/IMG_6145_1.jpg?v=1787222707" alt="Bree Wilkinson">
<div>
<header><strong>Bree Wilkinson</strong><small>BTM Support</small></header>
<p>Hey {{ member_name | escape }} 👋 This is your private space for anything you need help with in your business. Send questions, decisions, updates, screenshots, files or context below and we’ll pick it up here.</p>
</div>
</article>
<article class="btmcommsv2__message static">
<b class="avatar">BTM</b>
<div>
<header><strong>BTM Support Team</strong><small>Monday–Friday</small></header>
<p>For the quickest help, tell us what is happening, what you have already tried, what outcome you want, and what you need help deciding.</p>
</div>
</article>
</div>
<div class="btmcommsv2__typing" data-live-status><b class="avatar">BTM</b><span>•••</span><small data-live-status-text>Connecting to your private support space…</small></div>
<div class="btmcommsv2__composer">
<textarea rows="2" data-message-input placeholder="Message Bree + BTM Support..."></textarea>
<div class="btmcommsv2__selected" data-selected hidden></div>
<div class="btmcommsv2__composerbar is-minimal" data-drop>
<div class="btmcommsv2__composer-left">
<button type="button" class="btmcommsv2__iconbtn" data-open-files aria-label="Attach file"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 12.5 14.9 6.1a3.2 3.2 0 0 1 4.5 4.5l-8.2 8.2a5 5 0 0 1-7.1-7.1l8.1-8.1"></path></svg></button>
<button type="button" class="btmcommsv2__iconbtn" data-open-shot aria-label="Add screenshot"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="5.5" width="17" height="13" rx="2"></rect><circle cx="9" cy="10" r="1.5"></circle><path d="m6.5 16 3.2-3.2 2.3 2.2 2.7-3 2.8 4"></path></svg></button>
<span class="btmcommsv2__composer-mini-note">Private member support</span>
</div>
<button type="button" class="btmcommsv2__send" data-send-message><span>SEND</span> ➢</button>
</div>
<input type="file" data-file-input multiple hidden accept=".png,.jpg,.jpeg,.webp,.gif,.pdf,.doc,.docx,.xls,.xlsx,.csv,.txt">
<input type="file" data-shot-input multiple hidden accept="image/*">
</div>
<div class="btmcommsv2__note"><b>PRIVATE BTM SUPPORT</b><span data-send-note>Your message goes directly to Bree + the BTM Support Team. Replies will appear here.</span></div>
</section>
<aside class="btmcommsv2__rail">
<section class="btmcommsv2__card response"><span class="clock">◷</span><div><small>RESPONSE TIME</small><h3>Usually within a few hours.</h3><p>Monday–Friday, and always within 1 business day.</p></div></section>
<section class="btmcommsv2__card"><h2>☆ &nbsp;Best for</h2><ul><li>Business questions</li><li>Implementation help</li><li>Quick decisions or clarification</li><li>Offer, sales &amp; marketing feedback</li><li>Systems, team &amp; operations</li><li>Wins, updates &amp; accountability</li><li>Screenshots, files, links &amp; context</li></ul></section>
<section class="btmcommsv2__card">
<div class="btmcommsv2__cardhead"><h2>Conversation shortcuts</h2><button type="button" data-filter="all">View all</button></div>
<div class="btmcommsv2__shortcuts">
<button type="button" data-filter="files">▤ <span>Files</span><small data-cf>0</small></button>
<button type="button" data-filter="media">▧ <span>Media</span><small data-cm>0</small></button>
<button type="button" data-filter="links">↗ <span>Links</span><small data-cl>0</small></button>
<button type="button" data-filter="wins">☆ <span>Wins</span><small data-cw>0</small></button>
<button type="button" data-latest>↓ <span>Jump to latest</span><small>→</small></button>
<a href="/pages/btm-resources">▣ <span>Resources</span><small>→</small></a>
</div>
</section>
</aside>
</main>
</div>
{% elsif customer %}
<div class="btmcommsv2__access">
<div>
<span>BTM MEMBERS PORTAL</span>
<h1>Your membership access is not active yet.</h1>
<p>
You’re signed in, but this account does not currently have active Business Advisory
or Scale Society access.
</p>
<a href="/pages/contact-us">CONTACT THE BTM TEAM</a>
</div>
</div>
{% else %}
<div class="btmcommsv2__access">
<div>
<span>PRIVATE MEMBER SUPPORT</span>
<h1>Sign in to open Communications.</h1>
<p>
Use the email address connected to your BTM membership to access your private support space.
</p>
<a href="/customer_authentication/login?return_to={{ '/pages/btm-communications' | url_encode }}">
SIGN IN TO YOUR PORTAL
</a>
</div>
</div>
{% endif %}
</section>
<style>
